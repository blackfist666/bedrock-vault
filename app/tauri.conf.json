{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bedrock Vault",
  "version": "0.1.0",
  "identifier": "app.bedrockvault.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Bedrock Vault",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "mainBinaryName": "bedrock-vault",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "Bedrock Vault",
    "shortDescription": "Local world library manager for Minecraft Bedrock"
  }
}
